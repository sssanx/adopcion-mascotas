---
import Layout from "../layouts/Layout.astro";

const redirect = Astro.url.searchParams.get("redirect") || "/";
---

<Layout title="Iniciar Sesión">
  <section class="max-w-md mx-auto mt-10 p-6 bg-white shadow rounded">
    <h1 class="text-2xl font-bold mb-4">Iniciar Sesión</h1>

    <form id="loginForm" class="space-y-3">
      <div>
        <label>Email</label>
        <input type="email" name="email" class="w-full border px-3 py-2" required />
      </div>

      <div>
        <label>Contraseña</label>
        <input type="password" name="password" class="w-full border px-3 py-2" required />
      </div>

      <button class="w-full bg-amber-500 text-white py-2 rounded">Entrar</button>
    </form>

    <p class="text-sm mt-3">
      ¿No tienes cuenta? <a href="/register" class="text-amber-500">Regístrate</a>
    </p>
  </section>

  <script>
    document.getElementById("loginForm").addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = {
        email: e.target.email.value,
        password: e.target.password.value
      };

      const res = await fetch("/api/auth/login", {
        method: "POST",
        body: JSON.stringify(data)
      });

      const json = await res.json();

      if (json.success) {
        window.location.href = "${redirect}";
      } else {
        alert(json.error);
      }
    });
  </script>
</Layout>
