---
// src/pages/adopcion-exitosa.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Solicitud Enviada">
  <section class="max-w-2xl mx-auto mt-10 p-6 text-center">
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
      <h2 class="text-2xl font-bold mb-2">¡Solicitud enviada con éxito!</h2>
      <p>Hemos recibido tu solicitud de adopción. Nos pondremos en contacto contigo pronto.</p>
    </div>
    <a href="/" class="bg-amber-500 text-white px-6 py-2 rounded hover:bg-amber-400">
      Volver al inicio
    </a>
  </section>
</Layout>