---
// src/pages/error-adopcion.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Error en Solicitud">
  <section class="max-w-2xl mx-auto mt-10 p-6 text-center">
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
      <h2 class="text-2xl font-bold mb-2">Error al enviar la solicitud</h2>
      <p>Ocurrió un error al procesar tu solicitud. Por favor, intenta nuevamente.</p>
    </div>
    <a href="/" class="bg-amber-500 text-white px-6 py-2 rounded hover:bg-amber-400">
      Volver al inicio
    </a>
  </section>
</Layout>